---
import HeaderLink from "./HeaderLink.astro";
import DarkModeToggle from "./DarkModeToggle.astro";
import { GITHUB_URL, TWITTER_URL } from "../config";
---

<header>
  <a
    class="unset absolute z-10 left-[50%] -top-[100rem] translate-x-[-50%] bg-white text-black px-8 py-2 focus:top-[initial]"
    href="#main"
  >
    Skip to content
  </a>
  <nav>
    <section class="text-text-bold">
      <ul class="unset flex gap-4 [&>li]:p-0">
        <li><HeaderLink href="/">Home</HeaderLink></li>
        <li><HeaderLink href="/blog">Blog</HeaderLink></li>
        <li><HeaderLink href="/about">About</HeaderLink></li>
        <!-- <li><HeaderLink href="/projects">Projects</HeaderLink></li> -->
      </ul>
    </section>
  </nav>
  <div
    class="max-[375px]:hidden justify-self-end py-2 flex items-center content-center text-text-bold"
  >
    <a
      class="unset text-xl ml-4 hover:text-text-link"
      href={GITHUB_URL}
      target="_blank"
      rel="me noopener noreferrer"
    >
      <i class="fa-brands fa-github" aria-hidden="true" title="On GitHub"></i>
      <span class="fa-sr-only">On GitHub</span>
    </a>
    <a
      class="unset text-xl ml-4 hover:text-text-link"
      href={TWITTER_URL}
      target="_blank"
      rel="me noopener noreferrer"
    >
      <i
        class="fa-brands fa-twitter"
        aria-hidden="true"
        title="On Twitter"></i>
      <span class="fa-sr-only">On Twitter</span>
    </a>
    <a
      class="unset text-xl ml-4 hover:text-text-link"
      href="/rss.xml"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-solid fa-rss" aria-hidden="true" title="RSS feed"></i>
      <span class="fa-sr-only">RSS feed</span>
    </a>
  </div>
  <DarkModeToggle />
</header>
<style>
  header {
    grid-area: header;
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1fr) minmax(0, max-content) minmax(
        0,
        max-content
      );
  }
</style>
