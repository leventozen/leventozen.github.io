---
import { getBlogPostMeta } from "../lib/seo";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  TWITTER_HANDLE,
  MY_NAME,
} from "../config";

export interface Props {
  title?: string;
  description?: string;
  publishDate: string;
  pagePath?: string;
  categories?: string[];
  tags?: string[];
  ogImageAbsoluteUrl?: string;
  ogImageAltText?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  pagePath,
  title,
  description,
  publishDate,
  categories = [],
  tags = [],
  ogImageAbsoluteUrl,
  ogImageAltText,
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

const keywords = [...categories, ...tags];
const pageUrl = pagePath ? new URL(pagePath, SITE_URL).toString() : undefined;
const resolvedOgImage =
  ogImageAbsoluteUrl || `${SITE_URL}/images/og.png`;
const resolvedOgImageAlt =
  ogImageAltText || `Preview image for ${title || SITE_TITLE}`;

const { meta, og, twitter } = getBlogPostMeta({
  title: title || SITE_TITLE,
  description: description || SITE_DESCRIPTION,
  canonicalUrl: pageUrl,
  pageUrl,
  authorName: MY_NAME,
  publishDate,
  categories,
  tags,
  ogImageAbsoluteUrl: resolvedOgImage,
  ogImageAltText: resolvedOgImageAlt,
  ogImageWidth,
  ogImageHeight,
  siteOwnerTwitterHandle: TWITTER_HANDLE,
  contentAuthorTwitterHandle: TWITTER_HANDLE,
});
---

<!-- Primary Meta Tags -->
<title>{meta.title}</title>
<meta name="title" content={meta.title} />
{meta.description && <meta name="description" content={meta.description} />}
{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
{meta.canonicalUrl && <link rel="canonical" href={meta.canonicalUrl} />}

<!-- Open Graph / Facebook -->
{og.title && <meta property="og:title" content={og.title} />}
{og.description && <meta property="og:description" content={og.description} />}
{og.type && <meta property="og:type" content={og.type} />}
{og.url && <meta property="og:url" content={og.url} />}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{og.author && <meta property="article:author" content={og.author} />}
{
  og.publishDate && (
    <meta property="article:published_time" content={og.publishDate} />
  )
}
{og.section && <meta property="article:section" content={og.section} />}
{og.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
{og.image && <meta property="og:image" content={og.image} />}
{og.imageAlt && <meta property="og:image:alt" content={og.imageAlt} />}
{og.imageWidth && <meta property="og:image:width" content={og.imageWidth} />}
{og.imageHeight && <meta property="og:image:height" content={og.imageHeight} />}

<!-- Twitter -->
{twitter.title && <meta property="twitter:title" content={twitter.title} />}
{
  twitter.description && (
    <meta property="twitter:description" content={twitter.description} />
  )
}
{twitter.site && <meta property="twitter:site" content={twitter.site} />}
{
  twitter.creator && (
    <meta property="twitter:creator" content={twitter.creator} />
  )
}
<meta property="twitter:card" content="summary_large_image" />
{pageUrl && <meta property="twitter:url" content={pageUrl} />}
{twitter.image && <meta property="twitter:image" content={twitter.image} />}
{
  twitter.imageAlt && (
    <meta property="twitter:image:alt" content={twitter.imageAlt} />
  )
}
