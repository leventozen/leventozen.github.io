---
/*
  This is not a layout but just a component that's used in layouts.
*/
---

<script is:inline>
  // Follow the system color scheme by default. A manual toggle can override it.
  (function () {
    if (typeof window === "undefined") return;

    const media = window.matchMedia("(prefers-color-scheme: dark)");

    function getPreferredTheme() {
      const stored = sessionStorage.getItem("theme");
      if (stored === "dark" || stored === "light") return stored;
      return media.matches ? "dark" : "light";
    }

    function applyTheme(theme) {
      const root = document.documentElement;
      const themeColor = document.head.querySelector('meta[name="theme-color"]');

      if (theme === "dark") {
        root.classList.add("dark");
        root.classList.remove("light");
        if (themeColor) themeColor.content = "#0e141b";
      } else {
        root.classList.remove("dark");
        root.classList.add("light");
        if (themeColor) themeColor.content = "#ffffff";
      }
    }

    applyTheme(getPreferredTheme());

    media.addEventListener("change", () => {
      // Only track the OS theme while the user has not picked a manual override.
      if (!sessionStorage.getItem("theme")) {
        applyTheme(getPreferredTheme());
      }
    });
  })();
</script>
