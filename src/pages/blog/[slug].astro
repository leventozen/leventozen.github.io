---
import { readOne, readAll } from "../../lib/markdoc/read";
import { blog } from "../../lib/markdoc/frontmatter.schema";
import Renderer from "../../components/Renderer.astro";
import BlogPostMeta from "../../components/BlogPostMeta.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { SITE_URL } from "../../config";
import { getReadingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
  const posts = await readAll({
    directory: "blog",
    frontmatterSchema: blog,
  });

  // we don't want to generate pages for posts that link to external websites
  const filteredPosts = posts
    .filter((p) => p.frontmatter.draft !== true)
    .filter(({ frontmatter }) => !frontmatter.external);

  return filteredPosts.map((post) => {
    return { params: { slug: post.slug } };
  });
}

const { slug } = Astro.params;
if (typeof slug !== "string") {
  throw Error(`slug should be string. Received: ${slug}`);
}

const { content, rawContent, frontmatter } = await readOne({
  directory: "blog",
  slug,
  frontmatterSchema: blog,
});

const posts = (await readAll({
  directory: "blog",
  frontmatterSchema: blog,
}))
  .filter((post) => !post.frontmatter.draft && !post.frontmatter.external)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
  );

const currentIndex = posts.findIndex((post) => post.slug === slug);
const olderPost = currentIndex >= 0 ? posts[currentIndex + 1] : undefined;
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const previousPost = olderPost
  ? { slug: olderPost.slug, title: olderPost.frontmatter.title }
  : undefined;
const nextPost = newerPost
  ? { slug: newerPost.slug, title: newerPost.frontmatter.title }
  : undefined;
const readingTime = getReadingTime(rawContent);

// Keep the trailing slash so og:url/canonical match the live GitHub Pages URL.
const pagePath = `/blog/${slug}/`;
const pageUrl = new URL(pagePath, SITE_URL).toString();

const ogImageAbsoluteUrl =
  frontmatter.external !== true && frontmatter.ogImagePath
    ? new URL(frontmatter.ogImagePath, SITE_URL).toString()
    : `${SITE_URL}/images/og.jpg`;

const seoTitle =
  frontmatter.external !== true &&
  frontmatter.series &&
  frontmatter.seriesPart
    ? `${frontmatter.series}, Part ${frontmatter.seriesPart}: ${frontmatter.title}`
    : frontmatter.title;
---

<ContentLayout
  title={frontmatter.title}
  date={frontmatter.date}
  readingTime={readingTime}
  pageUrl={pageUrl}
  previousPost={previousPost}
  nextPost={nextPost}
  categories={frontmatter.categories}
  tags={frontmatter.tags}
  series={frontmatter.external ? undefined : frontmatter.series}
  seriesPart={frontmatter.external ? undefined : frontmatter.seriesPart}
  references={frontmatter.external ? [] : frontmatter.references}
>
  <BlogPostMeta
    title={seoTitle}
    description={frontmatter.external ? undefined : frontmatter.description}
    publishDate={frontmatter.date.toISOString()}
    pagePath={pagePath}
    categories={frontmatter.categories}
    tags={frontmatter.tags}
    ogImageAbsoluteUrl={ogImageAbsoluteUrl}
    ogImageAltText={seoTitle}
    ogImageWidth={1200}
    ogImageHeight={630}
    slot="meta"
  />
  <Renderer content={content} slot="content" />
</ContentLayout>
